rules_version = '2';

// Khutwa — Firestore security rules.
// Deploy with:  firebase deploy --only firestore:rules
//
// Model: a family document carries `memberUids: string[]`. Only members can
// read a family or touch its data. Joining goes through `inviteCodes/{CODE}`,
// which can be read by exact code but never listed, so families can't be
// enumerated and nobody can join without being given the code.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function familyDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId));
    }

    function isFamilyMember(familyId) {
      return signedIn() && request.auth.uid in familyDoc(familyId).data.memberUids;
    }

    // --- inviteCodes/{CODE} → { familyId } -----------------------------
    match /inviteCodes/{code} {
      allow get: if signedIn();          // look up one code you were given
      allow list: if false;              // no browsing every code
      // Only a member of the family can register its own invite code.
      allow create: if isFamilyMember(request.resource.data.familyId)
        && familyDoc(request.resource.data.familyId).data.inviteCode == code
        && request.resource.data.keys().hasOnly(['familyId']);
      allow update, delete: if false;
    }

    // --- families --------------------------------------------------------
    match /families/{familyId} {
      // Members only. `findFamilyForUser` queries array-contains on memberUids,
      // which these rules can verify for every result.
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      // The creator starts as the only member, and as the guardian.
      allow create: if signedIn()
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0].uid == request.auth.uid
        && request.resource.data.inviteCode is string;

      // Existing members may edit member details (e.g. location sharing), but
      // not add or remove anyone.
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.size() == resource.data.members.size();

      // A new member may add exactly themselves, as a plain member, and only by
      // presenting the family's invite code. Families hold at most 3 people.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.joinCode == resource.data.inviteCode
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberUids', 'joinCode'])
        && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
        && request.resource.data.memberUids.size() <= 3
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members[0:resource.data.members.size()] == resource.data.members
        && request.resource.data.members[resource.data.members.size()].uid == request.auth.uid
        && request.resource.data.members[resource.data.members.size()].role == 'member';

      allow delete: if false; // families are not deleted from the client

      // --- steps sub-collection --------------------------------------
      match /steps/{stepId} {
        allow read: if isFamilyMember(familyId);
        // A member may only write their own step rows (doc id starts with uid).
        allow write: if isFamilyMember(familyId)
          && stepId.split('_')[0] == request.auth.uid;
      }

      // --- rolling week-stats counters (stats/week) -----------------
      match /stats/{statId} {
        allow read, write: if isFamilyMember(familyId);
      }
    }

    // --- treeState -----------------------------------------------------
    match /treeState/{familyId} {
      allow read: if isFamilyMember(familyId);
      // The client recomputes and writes the tree. A Cloud Function could own
      // this later by changing `write` to `if false`.
      allow write: if isFamilyMember(familyId);
    }

    // --- memories (shared curated content) ---------------------------
    match /memories/{memoryId} {
      allow read: if signedIn();
      // The curated stories can't be created, rewritten or deleted from the
      // client. A user may only record their own unlock.
      allow create, delete: if false;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['unlockedBy', 'unlockedAt'])
        && request.resource.data.unlockedBy == request.auth.uid;
    }
  }
}
