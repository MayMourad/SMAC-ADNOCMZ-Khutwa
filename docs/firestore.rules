rules_version = '2';

// Khutwa — draft Firestore security rules.
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase console → Firestore → Rules)
//
// Model: a family document carries `memberUids: string[]`. A user may touch a
// family and its sub-collections only if their uid is in that array.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberUids;
    }

    // --- families -------------------------------------------------------
    match /families/{familyId} {
      // Readable to any signed-in user. This is deliberate: "find my family"
      // (query on memberUids) and "join by invite code" (query on inviteCode)
      // both need to read family docs the user isn't a member of yet. A family
      // doc only holds member display names + the invite code — the sensitive
      // data (location, memories, steps, tree) lives in locked collections.
      allow read: if signedIn();

      // Creating a family: the creator must include themselves as a member.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberUids;

      // Update is allowed as long as the writer ends up a member. This covers
      // both an existing member editing, and a new member adding themselves via
      // an invite code. (MVP simplification — a Cloud Function would police the
      // exact diff in production.)
      allow update: if signedIn()
        && request.auth.uid in request.resource.data.memberUids;

      allow delete: if false; // families are not deleted from the client

      // --- steps sub-collection --------------------------------------
      match /steps/{stepId} {
        allow read: if isFamilyMember(familyId);
        // A member may only write their own step rows (doc id starts with uid).
        allow write: if isFamilyMember(familyId)
          && stepId.split('_')[0] == request.auth.uid;
      }

      // --- rolling week-stats counters (stats/week) -----------------
      match /stats/{statId} {
        allow read, write: if isFamilyMember(familyId);
      }
    }

    // --- treeState -----------------------------------------------------
    match /treeState/{familyId} {
      allow read: if isFamilyMember(familyId);
      // For the MVP the client recomputes and writes the tree. Lock this down to
      // a Cloud Function later by changing `write` to `if false`.
      allow write: if isFamilyMember(familyId);
    }

    // --- memories (shared curated content) ---------------------------
    match /memories/{memoryId} {
      allow read: if signedIn();
      // Any signed-in user may create a memory doc — this is how
      // scripts/seed-firestore.ts loads the curated set (it signs in
      // anonymously first). Tighten to `if false` + an Admin SDK seed once
      // the content is stable.
      allow create: if signedIn();
      // After that, clients may only flip the unlock fields, nothing else.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['unlockedBy', 'unlockedAt']);
      allow delete: if false;
    }
  }
}
