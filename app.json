{
  "expo": {
    "name": "Khutwa",
    "slug": "Khutwa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "khutwa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "smac.adnocmz.khutwa",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "smac.adnocmz.khutwa",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Khutwa uses your location to unlock family stories at nearby heritage places and to bloom your family tree when you are together.",
          "locationAlwaysAndWhenInUsePermission": "Khutwa checks for nearby family places in the background so a story can be ready when you arrive. Location stays on your device and is never shared outside your family.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Khutwa reads your step count so your walks help grow the shared family tree."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "firebase": {
        "apiKey": "AIzaSyD-mlWwN2TBIi2s2ahBeUU-spkcYD2iDEc",
        "authDomain": "smac-adnocmz-khutwa.firebaseapp.com",
        "projectId": "smac-adnocmz-khutwa",
        "storageBucket": "smac-adnocmz-khutwa.firebasestorage.app",
        "messagingSenderId": "941848190225",
        "appId": "1:941848190225:web:6bb878b1f610c55faec0b0"
      },
      "llm": {
        "provider": "",
        "model": ""
      },
      "router": {},
      "eas": {
        "projectId": "1506ab59-d56a-4ae4-a7df-b50b29f4c938"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1506ab59-d56a-4ae4-a7df-b50b29f4c938"
    },
    "owner": "may.mourad"
  }
}
